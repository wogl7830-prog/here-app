rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // [공통 함수] 1. 로그인 여부 확인 (익명 로그인 포함)
    function isAuthenticated() {
      return request.auth != null;
    }

    // [공통 함수] 2. 데이터 소유자 확인 (문서의 경로 ID와 현재 사용자의 UID 일치 여부)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ---------------------------------------------------------
    // [컬렉션 규칙] 모든 사용자 데이터는 /users/{userId} 하위에 저장한다고 가정합니다.
    // ---------------------------------------------------------
    match /users/{userId} {
      
      // 1. 마이페이지 및 사용자 기본 정보 (users 컬렉션의 본인 문서)
      allow read, write: if isOwner(userId);
      
      // 2. 감정 기록 (본인의 감정 기록 서브 컬렉션) - 현재 사용 안함
      match /emotions/{emotionId} {
        allow read, write: if isOwner(userId);
      }

      // 3. 다락방 채팅 데이터 (본인의 다락방 기록 서브 컬렉션) - 현재 사용 안함
      match /atticChats/{chatId} {
        allow read, write: if isOwner(userId);
      }

      // 4. 금고(암호화된 데이터) 저장용 서브 컬렉션 (현재 활발히 사용 중인 경로)
      match /data/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---------------------------------------------------------
    // 만약 users/{userId} 하위가 아니라, 별도의 최상위 컬렉션을 둔다면 아래와 같이 작성합니다.
    // (예: 데이터를 넣을 때 문서 안에 uid 필드를 명시해서 넣는 방식)
    // ---------------------------------------------------------
    match /public_emotions/{docId} {
      // 읽기: 문서 안의 uid가 내 uid일 때만
      allow read, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      // 생성: 새로 만들려는 문서의 uid가 내 uid일 때만
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }
  }
}
